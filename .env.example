# Copia questo file in .env.local e compila i valori: .env.local resta fuori da git.
# I valori arrivano dal progetto Supabase (Task 0 del piano); il README spiega dove trovarli.

# URL del progetto e chiave publishable (finiscono nel browser: non sono segreti)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Chiave secret (sb_secret_…): SOLO SERVER. Scavalca le regole di accesso ai dati.
# Mai con prefisso NEXT_PUBLIC_, mai importata da codice che arriva al browser.
# Serve per le scritture dal server e per gli script di superadmin e pulizia.
SUPABASE_SECRET_KEY=

# Password del database: serve solo alla CLI per `supabase link` / `db push`.
# Non viene mai letta dall'app né spedita al browser.
SUPABASE_DB_PASSWORD=

# Indirizzo a cui scrivere per correggere il profilo (pubblico: compare nelle pagine).
NEXT_PUBLIC_SUPPORT_EMAIL=neosaps@proton.me

# Solo nel progetto di sviluppo: abilita gli script che cancellano dati (dati di esempio, pulizia, test).
# Il progetto di produzione NON deve avere questa variabile.
SUPABASE_PROJECT_ENV=development

# Numeri di prova con OTP fisso (Authentication → Sign In / Providers → Phone).
# Servono ai test del database e ai test end-to-end; da disattivare prima del lancio.
TEST_PHONE_USER_A=
TEST_OTP_USER_A=
TEST_PHONE_USER_B=
TEST_OTP_USER_B=
TEST_PHONE_SUPERADMIN=
TEST_OTP_SUPERADMIN=
